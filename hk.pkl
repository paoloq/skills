amends "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.6.0/hk@2.6.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["newlines"] = Builtins.newlines
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["jactionlint"] = Builtins.jactionlint
}

hooks {
  // `mise run check` runs this hook on every file, so CI lints what the commit hook lints
  ["check"] {
    steps = linters
  }
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps {
      ...linters
      // the same gate CI runs, so a commit that passes here passes there
      ["check"] {
        exclusive = true
        check = "mise run check"
      }
    }
  }
  // squash merges use the pull request title, so commits follow the same convention
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
}
