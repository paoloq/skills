#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# ///
#MISE description="Validate the Claude marketplace and plugin manifests"
"""Run `claude plugin validate` and fail on any error or warning but one.

The manifests carry no version on purpose, so installers track the latest
commit; the validator warns about that, and --strict would turn the warning
into a failure. Every other warning still fails. The output's plugin directory
checks, such as a missing icon, are skipped: the validator says they do not
change the result, and they matter only for a plugin submitted to
Anthropic's plugin directory.
"""

import subprocess
import sys

TARGETS = (".", ".claude-plugin/plugin.json")
ALLOWED_WARNING = "version: No version specified"
DIRECTORY_CHECKS_HEADING = "Plugin directory checks for"


def main() -> int:
    failed = False
    for target in TARGETS:
        result = subprocess.run(["claude", "plugin", "validate", target], capture_output=True, encoding="utf-8")
        output = result.stdout + result.stderr
        result_section = result.stdout.split(DIRECTORY_CHECKS_HEADING)[0] + result.stderr
        findings = [line.strip().lstrip("❯").strip() for line in result_section.splitlines() if line.strip().startswith("❯")]
        unexpected = [finding for finding in findings if ALLOWED_WARNING not in finding]
        if result.returncode != 0 or unexpected:
            print(output, file=sys.stderr)
            failed = True
        else:
            print(f"{target}: valid")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
