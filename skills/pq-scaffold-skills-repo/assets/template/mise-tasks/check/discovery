#!/usr/bin/env python3
#MISE description="Confirm npx skills finds every skill"
"""Check that `skills add . --list` lists every folder under skills/.

The installer skips a skill with unreadable frontmatter and still exits 0 when it
finds others, so its exit code alone proves nothing; it exits 1 when it finds none.
"""

import re
import subprocess
import sys
from pathlib import Path

ANSI_ESCAPE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def main() -> int:
    expected = sorted(path.name for path in Path("skills").glob("*") if path.is_dir())
    if not expected:
        print("no skills yet")
        return 0
    result = subprocess.run(["skills", "add", ".", "--list"], capture_output=True, text=True)
    listed = set(ANSI_ESCAPE.sub("", result.stdout + result.stderr).split())
    missing = [name for name in expected if name not in listed]
    for name in missing:
        print(f"skills/{name}: not found by npx skills", file=sys.stderr)
    if not missing:
        print(f"npx skills finds all {len(expected)} skills")
    return 1 if missing else 0


if __name__ == "__main__":
    sys.exit(main())
